<Window x:Class="XkDesk.Desktop.DesktopHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XkDesk Host"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False"
        ShowActivated="False"
        Width="200" Height="200"
        Background="#01000000">
    <Grid>
        <Border Width="400" Height="240" CornerRadius="12" Background="#800078D7"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="20" VerticalAlignment="Center">
                <TextBlock x:Name="MonitorText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="ModeText" Foreground="White" FontSize="14" Margin="0,6,0,0"/>
                <TextBlock x:Name="TimeText" Foreground="White" FontSize="20" Margin="0,6,0,14"/>
                <Button Content="退出 xk-desk" Width="140" Height="32" HorizontalAlignment="Left" Click="OnExitClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
