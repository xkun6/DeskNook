<UserControl x:Class="DeskNook.Views.IconItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True" UseLayoutRounding="True" Focusable="False">
    <Border x:Name="Frame" HorizontalAlignment="Center" VerticalAlignment="Top"
            BorderThickness="1" CornerRadius="2" Background="Transparent">
        <StackPanel x:Name="Stack">
            <Image x:Name="Icon" HorizontalAlignment="Center" Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="Label" TextAlignment="Center" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" Foreground="White"
                       TextOptions.TextFormattingMode="Display"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Direction="315" Color="Black" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
