<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- 安装包版本：由 tools/build-installer.ps1 从 DeskNook.exe 读取后传入；单独 dotnet build 时用默认值（仅影响文件名） -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.2</ProductVersion>
    <!-- AppPublishDir：发布目录（自带运行时或依赖框架；可用 -p:AppPublishDir= 覆盖），规范化为带结尾反斜杠的绝对路径 -->
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish</AppPublishDir>
    <PublishDir>$([MSBuild]::NormalizeDirectory('$(AppPublishDir)'))</PublishDir>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- NoRuntime：true = 依赖框架发布（不含 .NET 运行时），安装前检查 .NET 9 桌面运行时；默认 false = 自带运行时 -->
    <NoRuntime Condition="'$(NoRuntime)' == ''">false</NoRuntime>
    <OutputName>DeskNook-$(ProductVersion)-x64</OutputName>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\</OutputPath>
    <!-- ICE38/43/57：快捷方式放在 ProgramMenuFolder/DesktopFolder（per-machine 下解析为 All Users 目录），
         ICE 仍按“用户配置文件目录”要求 HKCU 键值，属于已知误报；组件键值用 HKLM 与 per-machine 安装保持一致。
         ICE61：MajorUpgrade 开了 AllowSameVersionUpgrades（同版本的两种变体可以互相覆盖），ICE61 对此只给警告 -->
    <SuppressIces>ICE38;ICE43;ICE57;ICE61</SuppressIces>
    <Cultures>zh-CN</Cultures>
    <DefineConstants>$(DefineConstants);PublishDir=$(PublishDir);NoRuntime=$(NoRuntime);DisplayVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Netfx.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
