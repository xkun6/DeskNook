<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <!--
    桌面整理（DeskNook）安装包：per-machine、x64。两种变体：默认自带 .NET 运行时；
    NoRuntime=true 时为依赖框架版，安装前检查 .NET 9 桌面运行时（x64）。
    版本号取自 DeskNook.exe 的文件版本（csproj 的 Version），UpgradeCode 固定不变，升级靠 MajorUpgrade。
  -->
  <Package Name="桌面整理"
           Manufacturer="DeskNook"
           Version="!(bind.FileVersion.DeskNook.exe)"
           UpgradeCode="E1003CA2-7DC8-4599-8EA1-FD0D1122559E"
           Language="2052"
           Scope="perMachine">

    <!-- 同一版本的“自带运行时/不带运行时”两种安装包 ProductCode 不同，AllowSameVersionUpgrades 允许互相升级替换，避免并存两份安装记录 -->
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本，无法安装此版本。" AllowSameVersionUpgrades="yes" />
<?if $(NoRuntime) = "true" ?>
    <!-- 依赖框架版：检查 .NET 9 桌面运行时（x64），缺失则停止安装（与应用默认的 Minor 前滚策略一致） -->
    <netfx:DotNetCompatibilityCheck Property="DOTNETDESKTOP9" RuntimeType="desktop" Platform="x64" Version="9.0.0" RollForward="minor" />
    <Launch Condition="Installed OR DOTNETDESKTOP9 = &quot;0&quot;" Message="此版本不含 .NET 运行时，需要先安装 .NET 9 桌面运行时（x64）：https://dotnet.microsoft.com/download/dotnet/9.0 。也可以改用自带运行时的安装包（文件名不含 noruntime）。" />
<?endif?>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- 添加/删除程序：显示名取 ProductName，图标用应用 ico；保留“卸载”，不提供“修改” -->
    <Icon Id="app.ico" SourceFile="..\src\DeskNook\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- 安装选项（命令行可覆盖：AUTOSTART=0 DESKTOPSHORTCUT=0），默认都勾选 -->
    <Property Id="AUTOSTART" Value="1" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />

    <!-- 升级时沿用旧版安装目录：按主程序组件 GUID 定位已安装的 DeskNook.exe 所在目录（1.0.0 未记录安装目录，所以不用注册表） -->
    <Property Id="INSTALLFOLDER" Secure="yes">
      <ComponentSearch Id="FindInstalledDeskNook" Guid="{16EB3D7D-1A37-5ADD-B757-D967A8BFEC9B}" Type="directory" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DeskNook">

        <!-- 主程序单独成组件（快捷方式与自定义动作都引用它），其余发布文件用 Files 通配收集 -->
        <!-- 固定 GUID = 1.0.0 起的自动生成值；升级时上面的 ComponentSearch 用它找旧安装目录，不要改 -->
        <Component Id="DeskNookExe" Guid="{16EB3D7D-1A37-5ADD-B757-D967A8BFEC9B}" Bitness="always64">
          <File Id="DeskNook.exe" Source="$(PublishDir)DeskNook.exe" KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- 发布目录全部文件（自带运行时版含 .NET 运行时；程序集 + DeskNookShellExt.dll），排除 pdb；data/ 由 build-installer.ps1 保证不在发布目录里 -->
    <ComponentGroup Id="PublishFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**">
        <Exclude Files="$(PublishDir)DeskNook.exe" />
        <Exclude Files="$(PublishDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- 开始菜单快捷方式：固定创建（all users） -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Bitness="always64">
        <Shortcut Id="StartMenuShortcut" Name="桌面整理" Description="桌面整理" Target="[INSTALLFOLDER]DeskNook.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\DeskNook" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- 桌面快捷方式：受 DESKTOPSHORTCUT 控制 -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Bitness="always64" Condition="DESKTOPSHORTCUT=1">
        <Shortcut Id="DesktopShortcut" Name="桌面整理" Description="桌面整理" Target="[INSTALLFOLDER]DeskNook.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\DeskNook" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="桌面整理" Level="1" AllowAdvertise="no" AllowAbsent="no">
      <ComponentRef Id="DeskNookExe" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentGroupRef Id="PublishFiles" />
    </Feature>

    <!--
      以安装用户身份（deferred + Impersonate）运行 DeskNook.exe 的命令行开关：
      HKCU 属于用户而不是 per-machine 安装服务，所以开机自启 / Shell 扩展注册都交给 exe 自己改写。
      全部 Return="ignore"：失败不拦截安装 / 卸载。
    -->
    <CustomAction Id="DeskNook.AutostartOn" FileRef="DeskNook.exe" ExeCommand="--autostart=on" Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="DeskNook.Exit" FileRef="DeskNook.exe" ExeCommand="--exit" Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="DeskNook.Unregister" FileRef="DeskNook.exe" ExeCommand="--unregister" Execute="deferred" Impersonate="yes" Return="ignore" />

    <InstallExecuteSequence>
      <!-- 仅全新安装：按选项写入开机自启（升级 / 修复 / 重装一律不碰，保留用户原设置） -->
      <Custom Action="DeskNook.AutostartOn" After="InstallFiles" Condition="AUTOSTART=1 AND NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE=&quot;ALL&quot;)" />
      <!-- 卸载与升级（旧版被移除）：先让运行中的实例退出（恢复系统图标），再删文件 -->
      <Custom Action="DeskNook.Exit" Before="DeskNook.Unregister" Condition="REMOVE=&quot;ALL&quot;" />
      <!-- 仅真正卸载：删除 Shell 扩展注册与开机自启（升级时保留） -->
      <Custom Action="DeskNook.Unregister" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- 兜底：exe 仍被占用时请求其关闭（配合 Restart Manager，不强杀进程） -->
    <util:CloseApplication Id="CloseDeskNook" Target="DeskNook.exe" CloseMessage="yes" EndSessionMessage="yes" RebootPrompt="no" />

    <!-- 完成页「运行桌面整理」：用 explorer.exe 间接启动，使 DeskNook 以普通用户（非提权）身份运行 -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="运行桌面整理" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApplication" Directory="INSTALLFOLDER" ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[#DeskNook.exe]&quot;" Return="asyncNoWait" />

    <!-- 界面：欢迎 → 选择目录 → 选项 → 确认安装（不含许可协议页，项目没有 EULA） -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <UI Id="DeskNookUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="InvalidDirDlg" />

      <!-- 自定义「选项」页 -->
      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}安装选项" HideCondition="WIX_UPGRADE_DETECTED" />
        <Control Id="TitleUpgrade" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}升级桌面整理" Hidden="yes" ShowCondition="WIX_UPGRADE_DETECTED" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="选择需要的附加选项。" HideCondition="WIX_UPGRADE_DETECTED" />
        <Control Id="DescriptionUpgrade" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="将升级到 v[ProductVersion]。" Hidden="yes" ShowCondition="WIX_UPGRADE_DETECTED" />
        <Control Id="AutostartCheck" Type="CheckBox" X="30" Y="65" Width="300" Height="18" Property="AUTOSTART" CheckBoxValue="1" Text="开机自动启动桌面整理" HideCondition="WIX_UPGRADE_DETECTED" />
        <Control Id="AutostartUpgradeNote" Type="Text" X="30" Y="65" Width="300" Height="18" Transparent="yes" NoPrefix="yes" Text="升级安装将保留当前的开机自启设置" Hidden="yes" ShowCondition="WIX_UPGRADE_DETECTED" />
        <Control Id="DesktopShortcutCheck" Type="CheckBox" X="30" Y="95" Width="300" Height="18" Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="创建桌面快捷方式" />
        <Control Id="StartMenuNote" Type="Text" X="30" Y="135" Width="300" Height="18" Transparent="yes" NoPrefix="yes" Text="开始菜单快捷方式将始终创建。" />
        <Control Id="UpgradeNote" Type="Text" X="30" Y="165" Width="300" Height="50" Transparent="yes" NoPrefix="yes" Text="检测到已安装的旧版本。继续后会先卸载旧版本，再安装 v[ProductVersion]；安装位置保持不变：[INSTALLFOLDER]。设置、格子布局与桌面文件都会保留。" Hidden="yes" ShowCondition="WIX_UPGRADE_DETECTED" />
      </Dialog>

      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_X64" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_X64" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="OptionsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Condition="NOT WIX_UPGRADE_DETECTED" />
      <Publish Dialog="OptionsDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Condition="WIX_UPGRADE_DETECTED" />
      <Publish Dialog="OptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
    </UI>

    <UIRef Id="WixUI_Common" />

  </Package>
</Wix>
